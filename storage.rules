rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'vMZQTGlYSfM8adohQAZmSE3cNX02' ||
        request.auth.token.email == 'rajkumar50036@gmail.com' ||
        request.auth.token.super_admin == true ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'FOUNDER' ||
        request.auth.token.admin == true
      );
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // Business logos and branding assets
    match /businesses/{businessId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() || (
        isAuthenticated() &&
        isValidImage() &&
        (
          // If Firestore security cross-checks or matching owner claim
          request.auth.uid != null
        )
      );
    }

    // User & Customer Profile Images
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        isValidImage()
      );
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}